# EditorConfig helps maintain consistent coding styles across different editors
# and IDEs. Settings here override editor defaults for everyone on the project.
# https://editorconfig.org

# This is the top-most .editorconfig file — stop searching parent directories.
root = true

# ─── Defaults (all files) ─────────────────────────────────────────────────────
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

# ─── Markdown ─────────────────────────────────────────────────────────────────
# Markdown uses trailing spaces to force line breaks — do not trim them.
[*.md]
trim_trailing_whitespace = false

# ─── JSON ─────────────────────────────────────────────────────────────────────
[*.json]
indent_size = 2

# ─── YAML ─────────────────────────────────────────────────────────────────────
[*.{yml,yaml}]
indent_size = 2

# ─── Prisma ───────────────────────────────────────────────────────────────────
[*.prisma]
indent_size = 2
