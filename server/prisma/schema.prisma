// ─── SIMS Prisma Schema ───────────────────────────────────────────────────────
//
// Smart Inventory Management System — database schema.
// This file is the single source of truth for the database structure.
//
// Prisma 7 change: The database connection URL is no longer configured here.
// It is now in server/prisma.config.ts (for CLI commands) and in
// process.env.DATABASE_URL (for PrismaClient runtime via server/.env).
//
// After any change to this file, run:
//   npm run db:generate --workspace=server   ← regenerates the TypeScript client
//   npm run db:migrate --workspace=server    ← creates and applies a migration
//
// Docs: https://pris.ly/d/prisma-schema
// ─────────────────────────────────────────────────────────────────────────────

// ─── Generator ───────────────────────────────────────────────────────────────
// Instructs Prisma to generate the TypeScript client.
// Output: server/prisma/generated/client/ (Prisma 7 default)
// Import: import { PrismaClient } from '@prisma/client';
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// ─── Datasource ──────────────────────────────────────────────────────────────
// Declares the database type (PostgreSQL).
// The connection URL is configured in prisma.config.ts (CLI) and read from
// process.env.DATABASE_URL at runtime by PrismaClient.
datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  EMPLOYEE

  @@map("user_roles")
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED

  @@map("purchase_statuses")
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED

  @@map("sale_statuses")
}

enum InventoryTransactionType {
  PURCHASE_RECEIPT
  SALE_COMPLETION
  MANUAL_ADJUSTMENT

  @@map("inventory_transaction_types")
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  STOCK_ADJUSTMENT

  @@map("activity_actions")
}

// ─── Models ──────────────────────────────────────────────────────────────────
// Model names use PascalCase. Tables and columns use snake_case through @map
// and @@map, which keeps the TypeScript API idiomatic while matching PostgreSQL
// conventions. All monetary values use PostgreSQL Decimal, never floating point.

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  firstName    String   @map("first_name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(100)
  role         UserRole @default(EMPLOYEE)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  purchasesCreated      Purchase[]             @relation("PurchasesCreatedBy")
  salesCreated          Sale[]                 @relation("SalesCreatedBy")
  inventoryTransactions InventoryTransaction[] @relation("InventoryTransactionsCreatedBy")
  activityLogs          ActivityLog[]          @relation("ActivityLogsPerformedBy")
  refreshTokens         RefreshToken[]

  @@index([isActive])
  @@map("users")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(120)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@map("categories")
}

model Supplier {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(160)
  contactPerson String?  @map("contact_person") @db.VarChar(160)
  email         String?  @db.VarChar(255)
  phone         String?  @db.VarChar(50)
  address       String?  @db.Text
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products  Product[]  @relation("PreferredSupplier")
  purchases Purchase[]

  @@index([name])
  @@index([isActive])
  @@map("suppliers")
}

model Product {
  id              String   @id @default(uuid()) @db.Uuid
  sku             String   @unique @db.VarChar(100)
  name            String   @db.VarChar(200)
  description     String?  @db.Text
  categoryId      String   @map("category_id") @db.Uuid
  supplierId      String?  @map("supplier_id") @db.Uuid
  unitPrice       Decimal  @map("unit_price") @db.Decimal(12, 2)
  costPrice       Decimal  @map("cost_price") @db.Decimal(12, 2)
  quantity        Int      @default(0)
  reorderLevel    Int      @default(0) @map("reorder_level")
  reorderQuantity Int?     @map("reorder_quantity")
  unit            String   @default("pcs") @db.VarChar(32)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  category              Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supplier              Supplier?              @relation("PreferredSupplier", fields: [supplierId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  purchaseItems         PurchaseItem[]
  saleItems             SaleItem[]
  inventoryTransactions InventoryTransaction[]

  @@index([name])
  @@index([categoryId])
  @@index([supplierId])
  @@index([isActive])
  @@index([quantity, reorderLevel])
  @@map("products")
}

model Purchase {
  id             String         @id @default(uuid()) @db.Uuid
  purchaseNumber String         @unique @map("purchase_number") @db.VarChar(50)
  supplierId     String         @map("supplier_id") @db.Uuid
  createdById    String         @map("created_by_id") @db.Uuid
  status         PurchaseStatus @default(DRAFT)
  totalAmount    Decimal        @default(0) @map("total_amount") @db.Decimal(12, 2)
  notes          String?        @db.Text
  orderedAt      DateTime?      @map("ordered_at") @db.Timestamptz(6)
  receivedAt     DateTime?      @map("received_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  supplier              Supplier               @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy             User                   @relation("PurchasesCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items                 PurchaseItem[]
  inventoryTransactions InventoryTransaction[]

  @@index([supplierId])
  @@index([createdById])
  @@index([status, createdAt])
  @@map("purchases")
}

model PurchaseItem {
  id         String  @id @default(uuid()) @db.Uuid
  purchaseId String  @map("purchase_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  quantity   Int
  unitCost   Decimal @map("unit_cost") @db.Decimal(12, 2)
  subtotal   Decimal @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([purchaseId, productId])
  @@index([productId])
  @@map("purchase_items")
}

model Sale {
  id            String     @id @default(uuid()) @db.Uuid
  saleNumber    String     @unique @map("sale_number") @db.VarChar(50)
  createdById   String     @map("created_by_id") @db.Uuid
  customerName  String?    @map("customer_name") @db.VarChar(160)
  customerEmail String?    @map("customer_email") @db.VarChar(255)
  customerPhone String?    @map("customer_phone") @db.VarChar(50)
  status        SaleStatus @default(DRAFT)
  totalAmount   Decimal    @default(0) @map("total_amount") @db.Decimal(12, 2)
  notes         String?    @db.Text
  completedAt   DateTime?  @map("completed_at") @db.Timestamptz(6)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy             User                   @relation("SalesCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items                 SaleItem[]
  inventoryTransactions InventoryTransaction[]

  @@index([createdById])
  @@index([status, createdAt])
  @@index([completedAt])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(uuid()) @db.Uuid
  saleId    String  @map("sale_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([saleId, productId])
  @@index([productId])
  @@map("sale_items")
}

model InventoryTransaction {
  id              String                   @id @default(uuid()) @db.Uuid
  productId       String                   @map("product_id") @db.Uuid
  transactionType InventoryTransactionType @map("transaction_type")
  quantityDelta   Int                      @map("quantity_delta")
  quantityBefore  Int                      @map("quantity_before")
  quantityAfter   Int                      @map("quantity_after")
  purchaseId      String?                  @map("purchase_id") @db.Uuid
  saleId          String?                  @map("sale_id") @db.Uuid
  createdById     String?                  @map("created_by_id") @db.Uuid
  reason          String?                  @db.Text
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  purchase  Purchase? @relation(fields: [purchaseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sale      Sale?     @relation(fields: [saleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy User?     @relation("InventoryTransactionsCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([productId, createdAt])
  @@index([purchaseId])
  @@index([saleId])
  @@index([createdById, createdAt])
  @@map("inventory_transactions")
}

model ActivityLog {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String?        @map("user_id") @db.Uuid
  action     ActivityAction
  entityType String         @map("entity_type") @db.VarChar(100)
  entityId   String?        @map("entity_id") @db.Uuid
  metadata   Json?
  ipAddress  String?        @map("ip_address") @db.Inet
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation("ActivityLogsPerformedBy", fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("activity_logs")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
