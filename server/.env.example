# ─── server/.env.example ─────────────────────────────────────────────────────
#
# This file is COMMITTED to version control as a template.
# Copy it to server/.env and fill in real values.
#
#   cp server/.env.example server/.env
#
# NEVER commit server/.env — it contains secrets.
# server/.env is excluded by .gitignore.
#
# ─────────────────────────────────────────────────────────────────────────────

# ─── Server ──────────────────────────────────────────────────────────────────

NODE_ENV=development

# Port the Express server listens on.
# Default: 5000. macOS AirPlay Receiver uses port 5000 — disable it in
# System Settings → General → AirDrop & Handoff if there is a conflict.
PORT=5000

# Host interface to bind to.
# 0.0.0.0 binds to all interfaces (accessible from LAN).
# 127.0.0.1 binds to localhost only.
HOST=0.0.0.0

# ─── Database ────────────────────────────────────────────────────────────────
#
# PostgreSQL connection string. Choose one of the two options below:
#
# Option A — Local PostgreSQL (Homebrew):
#   Install: brew install postgresql@16
#   Start:   brew services start postgresql@16
#   Create:  createdb sims_dev
#   Format:  postgresql://USERNAME:PASSWORD@localhost:5432/sims_dev
#
# Option B — Local PostgreSQL (Postgres.app):
#   Download: https://postgresapp.com
#   Create:   psql -c "CREATE DATABASE sims_dev;"
#   Format:   postgresql://USERNAME@localhost:5432/sims_dev
#             (Postgres.app uses the macOS username with no password by default)
#
# Option C — Neon (free tier, no local install required):
#   Sign up:  https://neon.tech
#   Create a project → copy the connection string
#   Format:   postgresql://USERNAME:PASSWORD@ep-XXXX.REGION.aws.neon.tech/sims_dev?sslmode=require
#   Note:     The ?sslmode=require suffix is required for Neon connections.
#
DATABASE_URL=postgresql://postgres:password@localhost:5432/sims_dev

# ─── JWT Authentication (introduced in Task 15) ──────────────────────────────
#
# SECURITY: These must be long, random strings. Use different values for
# ACCESS and REFRESH — if one is compromised, the other remains secure.
#
# Generate a secure value with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#   or
#   openssl rand -hex 64
#
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-64-characters
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-at-least-64-characters
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS (introduced in Task 10) ─────────────────────────────────────────────
#
# The URL where the React client is served.
# In development: http://localhost:5173 (Vite dev server)
# In production:  https://your-domain.com
#
# The Express CORS middleware uses this to allow requests only from this origin.
CLIENT_URL=http://localhost:5173
